# Backend Server Runtime Configuration
PORT=4000
NODE_ENV=development

# Storage Configuration
STORAGE_DIR=./uploads
MAX_UPLOAD_BYTES=15728640
MAX_PAGE_COUNT=20

# Feature Flags & Access Control
PUBLIC_ACCESS_ENABLED=true
OCR_ENGINE_ENABLED=false
FEATURE_NL_SQL_ENABLED=true
SQL_STATEMENT_TIMEOUT_MS=2000
SQL_ACCESS_SECRET=your-secure-sql-access-token

# Optional External AI Platform (OpenAI / Gemini / Anthropic / Document AI)
# Leave blank to use local deterministic PDF layout and token extraction
AI_PLATFORM_API_KEY=
AI_PLATFORM_API_URL=

# Optional Notification Service Integration (e.g. webhook endpoint)
# Leave blank to use in-memory logged alert mock
NOTIFICATION_SERVICE_URL=
NOTIFICATION_SERVICE_API_KEY=
