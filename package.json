{
  "name": "ai-document-intelligence",
  "version": "1.0.0",
  "description": "AI Multimodal Document Intelligence Platform",
  "private": true,
  "scripts": {
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build:all": "npm run build:backend && npm run build:frontend",
    "test:backend": "npm run test --prefix backend",
    "test:backend:e2e": "npm run test:e2e --prefix backend",
    "test:frontend": "npm run test --prefix frontend",
    "test:all": "npm run test:backend && npm run test:backend:e2e && npm run test:frontend",
    "start:backend": "npm run start:dev --prefix backend",
    "start:frontend": "npm run dev --prefix frontend"
  }
}
