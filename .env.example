# ==============================================================================
# AI Multimodal Document Intelligence - Global Environment Configuration Reference
# ==============================================================================
# NOTE: In production (Vercel & Render), configure these variables directly in the
# corresponding host environment settings. Never commit secrets to version control.

# ------------------------------------------------------------------------------
# BACKEND RUNTIME CONFIGURATION (Owner: NestJS Backend / Render)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Secure storage directory (must be on private server filesystem or disk volume)
STORAGE_DIR=./uploads
MAX_UPLOAD_BYTES=15728640
MAX_PAGE_COUNT=20

# Feature toggles & security limits
OCR_ENGINE_ENABLED=false
FEATURE_NL_SQL_ENABLED=true
SQL_STATEMENT_TIMEOUT_MS=2000
SQL_ACCESS_SECRET=your-backend-runtime-sql-secret-token

# Optional external AI platform integration (Leave blank for deterministic extraction)
AI_PLATFORM_API_KEY=
AI_PLATFORM_API_URL=

# Optional notification service webhook (Leave blank for in-memory logged mock)
NOTIFICATION_SERVICE_URL=
NOTIFICATION_SERVICE_API_KEY=

# ------------------------------------------------------------------------------
# FRONTEND PUBLIC CONFIGURATION (Owner: Next.js Frontend / Vercel)
# ------------------------------------------------------------------------------
# Only public, non-secret variables are permitted in the frontend.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
