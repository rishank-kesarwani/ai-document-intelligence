# ==============================================================================
# AI Multimodal Document Intelligence - Global Environment Configuration Reference
# ==============================================================================
# NOTE: In production (Vercel & Render), configure these variables directly in the
# corresponding host environment settings. Never commit secrets to version control.

# ------------------------------------------------------------------------------
# BACKEND RUNTIME CONFIGURATION (Owner: NestJS Backend / Render)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# CORS Allowed Frontend Origin(s) (comma-separated, e.g. http://localhost:3000,https://your-frontend.vercel.app)
# Leave unset or blank to allow all origins ('*').
FRONTEND_URL=http://localhost:3000

# Access Control & Public Demo Policy
# When true, unauthenticated demo exploration is permitted with tenant-demo-default fallback and demo dataset seeding.
# When false, strict tenant isolation is enforced: anonymous requests are rejected (401), tenant-demo-default is blocked (403),
# and demo seeding (/api/v1/documents/demo/seed) is denied (403).
PUBLIC_ACCESS_ENABLED=true

# Secure storage directory (must be on private server filesystem or disk volume)
STORAGE_DIR=./uploads
MAX_UPLOAD_BYTES=15728640
MAX_PAGE_COUNT=20

# Feature toggles & security limits
OCR_ENGINE_ENABLED=false
FEATURE_NL_SQL_ENABLED=true
SQL_STATEMENT_TIMEOUT_MS=2000
SQL_ACCESS_SECRET=your-backend-runtime-sql-secret-token

# Optional external AI platform integration (Leave blank for deterministic extraction)
AI_PLATFORM_API_KEY=
AI_PLATFORM_API_URL=

# Optional notification service webhook (Leave blank for in-memory logged mock)
NOTIFICATION_SERVICE_URL=
NOTIFICATION_SERVICE_API_KEY=

# ------------------------------------------------------------------------------
# FRONTEND PUBLIC CONFIGURATION (Owner: Next.js Frontend / Vercel)
# ------------------------------------------------------------------------------
# All NEXT_PUBLIC_* variables are public and embedded at build time.
# On Vercel, set NEXT_PUBLIC_API_URL to your deployed Render backend API URL
# (e.g., https://your-backend.onrender.com/api/v1) and redeploy.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_ACCESS_ENABLED=true
NEXT_PUBLIC_DEFAULT_TENANT_ID=tenant-demo-default
