# ==============================================================================
# Frontend Public Configuration (Next.js / Vercel / Local)
#
# IMPORTANT:
# - All NEXT_PUBLIC_* variables are embedded into the client-side JavaScript bundle
#   at build time. Never place secret keys or sensitive credentials here.
# - When deploying on Vercel, configure NEXT_PUBLIC_API_URL with your actual Render
#   backend API base URL (e.g., https://your-backend.onrender.com/api/v1) and
#   trigger a rebuild/redeployment for the changes to take effect.
# ==============================================================================

# Backend API Base URL
# Must include /api/v1 exactly once (the client automatically normalizes trailing slashes).
# Local development default: http://localhost:4000/api/v1
# Production (Render) example: https://ai-document-intelligence-api.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Public Demo Access Flag (Presentation & Client Feature Gate)
# - When true: UI enables demo explore mode and synthetic demo dataset seeder.
# - When false: UI hides/locks demo-only actions and alerts user to configure an authorized tenant.
# NOTE: The backend's PUBLIC_ACCESS_ENABLED flag is the authoritative gatekeeper.
NEXT_PUBLIC_ACCESS_ENABLED=true

# Default Tenant Identifier
# Tenant boundary used for unauthenticated demo requests when public access is enabled.
NEXT_PUBLIC_DEFAULT_TENANT_ID=tenant-demo-default
